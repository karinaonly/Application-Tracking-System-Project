# ATS Resume Fixer -- backend environment example.
# Copy to .env and fill in real values. Never commit the real .env.

# SQLite URL. Defaults to <backend>/ats_resume_fixer.db when unset.
# DATABASE_URL=sqlite:///./ats_resume_fixer.db

# ---- AI rewriting (Groq / OpenAI / Gemini) ----
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Optional overrides:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_TIMEOUT_SECONDS=20
# E4: set false to never send resume text to the provider (local analysis still runs).
AI_REWRITING_ENABLED=true

# ---- Auth (E1: required; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))") ----
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=43200
# E3: set false to close sign-ups once your account exists.
ALLOW_REGISTRATION=true

# ---- CORS (E2): comma-separated frontend origins ----
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# ---- Misc ----
ENVIRONMENT=development
UPLOAD_DIR=./uploads
# E5: opt-in SQL logging (prints bound values, incl. resume text). Leave off.
DB_ECHO=false
